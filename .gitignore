# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle/*
!/.bundle/config

# Ignore all environment files (except templates).
#/env*
!/.env*.erb
.env

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files sign_in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
/public/assets

# Ignore vendor files for not to increase repository size huge
/vendor


# Added by Owner
.DS_Store
.idea
.env.local
/coverage
.cache
.local/
.irb_history
.psql_history
.bash_history
.guard_history
.run/coverage
.bun/install/
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules
.run
.solargraph.yml
.dotnet
.vscode-server
.ssh
.gnupg
.envrc
!.vscode/
.vscode/*
!.vscode/extensions.json
.config/
.bun
.node_repl_history
.npm/
.ash_history
.emacs.d/
.codex/
.claude.json
.claude.json.backup
.claude/settings.local.json
.claude/

# Vite Ruby
/public/vite*
/public/uploads
node_modules
# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vitejs.dev/guide/env-and-mode.html#env-files
*.local
.gitconfig

/doc/*
!/doc/.keep
.yardoc/
/.ruby-lsp/
.dist/

# Ignore keys for decrypting credentials and more.
# Keys are provisioned out of band; see
# docs/operations/development-credential-provisioning.md
/config/master.key
/config/*.key
/config/credentials/*.key
/*.key

# The production credentials payload is provisioned out of band and never
# committed, unlike the tracked development.yml.enc / test.yml.enc.
/config/credentials/production.yml.enc

# misc
/.crush/
/.dbclient/
/.rest-client/

# Ruby & JavsScript are not create /out folders.
/out

# Debug scripts (should not be committed)
/check_email_otp.rb
/generate_hotp_code.rb
/test_telephone_email.rb
/test_telephone_email_simple.rb

/docker/core/preferences/*
!/docker/core/preferences/.bashrc
/docker/core/preferences/.bash_history
/podman/core/preferences/*
!/podman/core/preferences/.bashrc
/podman/core/preferences/.bash_history
erd.pdf
.pnpm-store/
.claudeignore
test_output*.txt
.gemini/
gha-creds-*.json
nvim.log
.codex
.junie/
.air/

# Local/private documentation scratch space. Shared docs, ADRs, plans, notes, and memos stay
# tracked; sensitive or machine-local material belongs in these ignored subdirectories only.
/docs/local/
/docs/private/
/docs/tmp/
/adr/local/
/adr/private/
/adr/tmp/
/memos/local/
/memos/private/
/memos/tmp/
/notes/local/
/notes/private/
/notes/tmp/
/plans/local/
/plans/private/
/plans/tmp/
/plans/drafts/local/
.antigravitycli/
.secrets/
app/javascript/node_modules
app/javascript/coverage

# Vite Ruby
/public/vite*
node_modules
# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vitejs.dev/guide/env-and-mode.html#env-files
*.local

# Vite Ruby
/public/vite*
node_modules
# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vitejs.dev/guide/env-and-mode.html#env-files
*.local


# Vite Ruby
/public/vite*
node_modules
# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vitejs.dev/guide/env-and-mode.html#env-files
*.local

# Optional developer-local Compose override. `compose.yaml` alone is a complete
# standard environment, so this file is never required and is never created
# automatically -- a fresh clone must start without it. Documented by the
# tracked `compose.override.yaml.example`, which nobody has to copy.
#
# Not to be confused with `.devcontainer/compose.override.yml`, which IS tracked
# and IS part of the standard Dev Container configuration.
/compose.override.yaml

# Merge residue. `git mergetool` and a conflicted `git checkout --merge` write these
# beside the file they back up, and three `.orig` backups reached a commit that way.
*.orig
*.rej

# Vitest Browser Mode / local attachments cache
.vitest/
