{
  "service_version": "0.3.0",
  "schema": 1,
  "header": {
    "typ": "JWT",
    "alg": "ES384",
    "kid_max_length": 128
  },
  "required_claims": [
    "schema",
    "rpl",
    "iss",
    "aud",
    "sub",
    "iat",
    "nbf",
    "exp",
    "jti",
    "src",
    "dst",
    "url"
  ],
  "rpl": "reuse",
  "sub": "jump-redirect",
  "dst": "internal",
  "ttl_seconds": 30,
  "clock_tolerance_seconds": 5,
  "max_token_characters": 8192,
  "url_comparison": "WHATWG URL, remove exactly one rt, serialize URLSearchParams, match signed url",
  "transaction_owner": "receiver",
  "downstream_redirect_owner": "receiver",
  "authentication_granted": false,
  "csrf_granted": false,
  "one_time_execution_granted": false,
  "inbound_max_ttl_seconds": 30,
  "url_cases": [
    {
      "name": "exact returned rt",
      "signed_url": "https://www.umaxica.app/receive?state=a&code=b",
      "request_url": "https://www.umaxica.app/receive?state=a&code=b&rt=returned",
      "accepted": true
    },
    {
      "name": "duplicate rt",
      "signed_url": "https://www.umaxica.app/receive?state=a",
      "request_url": "https://www.umaxica.app/receive?state=a&rt=one&rt=two",
      "accepted": false
    },
    {
      "name": "array rt",
      "signed_url": "https://www.umaxica.app/receive?state=a",
      "request_url": "https://www.umaxica.app/receive?state=a&rt=returned&rt%5B%5D=other",
      "accepted": false
    },
    {
      "name": "nested rt",
      "signed_url": "https://www.umaxica.app/receive?state=a",
      "request_url": "https://www.umaxica.app/receive?state=a&rt=returned&rt%5Bx%5D=other",
      "accepted": false
    },
    {
      "name": "missing exact rt",
      "signed_url": "https://www.umaxica.app/receive?state=a",
      "request_url": "https://www.umaxica.app/receive?state=a&rt%5B%5D=returned",
      "accepted": false
    },
    {
      "name": "duplicate state",
      "signed_url": "https://www.umaxica.app/receive?state=a",
      "request_url": "https://www.umaxica.app/receive?state=a&state=b&rt=returned",
      "accepted": false
    },
    {
      "name": "duplicate code",
      "signed_url": "https://www.umaxica.app/receive?code=a",
      "request_url": "https://www.umaxica.app/receive?code=a&code=b&rt=returned",
      "accepted": false
    },
    {
      "name": "ordering is binding",
      "signed_url": "https://www.umaxica.app/receive?state=a&code=b",
      "request_url": "https://www.umaxica.app/receive?code=b&state=a&rt=returned",
      "accepted": false
    },
    {
      "name": "percent space equivalent",
      "signed_url": "https://www.umaxica.app/receive?q=a+b",
      "request_url": "https://www.umaxica.app/receive?q=a%20b&rt=returned",
      "accepted": true
    },
    {
      "name": "percent value equivalent",
      "signed_url": "https://www.umaxica.app/receive?state=a",
      "request_url": "https://www.umaxica.app/receive?state=%61&rt=returned",
      "accepted": true
    },
    {
      "name": "percent key equivalent",
      "signed_url": "https://www.umaxica.app/receive?state=a",
      "request_url": "https://www.umaxica.app/receive?%73tate=a&%72t=returned",
      "accepted": true
    },
    {
      "name": "literal plus non-equivalent",
      "signed_url": "https://www.umaxica.app/receive?q=a+b",
      "request_url": "https://www.umaxica.app/receive?q=a%2Bb&rt=returned",
      "accepted": false
    },
    {
      "name": "changed code non-equivalent",
      "signed_url": "https://www.umaxica.app/receive?code=a",
      "request_url": "https://www.umaxica.app/receive?code=b&rt=returned",
      "accepted": false
    }
  ]
}
