{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "singleAttributePerLine": true,
  "proseWrap": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "embeddedLanguageFormatting": "auto",
  "sortImports": {},
  "sortPackageJson": true,
  "ignorePatterns": [
    "node_modules/**",
    "vendor/**",
    "tmp/**",
    "dist/**",
    "build/**",
    "coverage/**",
    ".ruby-lsp/**",
    "public/assets/**",
    "public/packs/**",
    "openapi/bundled/openapi*.yml",
    "db/**",
    "log/**"
  ]
}
