<!doctype html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex,nofollow">
    <%= display_meta_tags site: "#{ENV.fetch("BRAND_NAME").upcase} (#{controller.class.name.split("::").fetch(1).upcase})",
                          title: t("actions.continue"), separator: "—", reverse: true %>
  </head>
  <body>
    <form method="post" action="<%= action_url %>" data-turbo="false">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <%= hidden_field_tag :ri, params[:ri] if params[:ri].present? %>
      <% if restart_binding %>
        <%= hidden_field_tag :restart_of, restart_binding.entry_ref %>
      <% end %>
      <% label_key =
        if restart_binding&.redeemed?
          "actions.cancel_and_start"
        elsif restart_binding
          "actions.restart"
        else
          "actions.continue"
        end %>
      <button type="submit"><%= t(label_key) %></button>
    </form>
  </body>
</html>
