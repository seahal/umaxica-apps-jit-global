<!doctype html>
<html lang="en">
  <head>
    <%= display_meta_tags title: I18n.t("actions.continue") %>
    <meta charset="utf-8">
    <meta name="robots" content="noindex,nofollow">
  </head>
  <body>
    <form id="base-ceremony-binding-confirmation-form" method="post" action="<%= request.path %>" data-turbo="false">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <%= hidden_field_tag :ri, params[:ri] if params[:ri].present? %>
      <%= hidden_field_tag :lx, lx if lx.present? %>
      <button type="submit">Continue</button>
    </form>
  </body>
</html>
