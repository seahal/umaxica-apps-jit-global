<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex,nofollow">
  </head>
  <body>
    <form id="base-authorization-ceremony-start-form" method="post" action="<%= action_url %>" data-turbo="false">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <%= hidden_field_tag :ceremony_action, "start" %>
      <% fields.each do |name, value| %>
        <% Array(value).each do |item| %>
          <%= hidden_field_tag name, item %>
        <% end %>
      <% end %>
    </form>
    <button form="base-authorization-ceremony-start-form" type="submit">Continue</button>
  </body>
</html>
