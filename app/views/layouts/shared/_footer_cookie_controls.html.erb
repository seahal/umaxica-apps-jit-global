<% hide_cookie_banner =
     params[:action].to_s == "edit" &&
     (params[:preference_screen].to_s == "cookie" ||
      controller_path.end_with?("/preference/cookies")) %>

<% unless hide_cookie_banner %>
<%# Cookie preference editing lives on base/www (adr/identity-authority-boundary.md).
    Use the base _url helper so the link resolves to the base host even when this
    banner renders on a sign page. %>
<% cookie_settings_url =
     public_send(
       "edit_base_#{scope}_preference_cookie_url",
       **request.query_parameters.slice("ri", "lx", "ct", "tz", "cu", "df", "tf", "mo", "dn", "ps").symbolize_keys.merge(
         if local_assigns.key?(:base_host)
           { host: base_host }
         elsif local_assigns.key?(:acme_host)
           { host: acme_host }
         else
           {}
         end,
       ),
     ) %>

<div
  id="cookie-banner"
  data-controller="cookie-banner"
  data-cookie-banner-endpoint-url-value="<%= local_assigns.fetch(:endpoint_url) %>"
  data-cookie-banner-settings-url-value="<%= cookie_settings_url %>"
  role="region"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-desc"
  class="ui-cookie">
  <div class="ui-cookie__body">

    <div class="ui-cookie__heading">
    <h2 id="cookie-title">
      <%= t(".title") %>
    </h2>
    <button
      type="button"
      data-action="cookie-banner#invisible"
      aria-label="<%= t(".close_button") %>"
      class="ui-cookie__close">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
    </div>

    <!-- Description -->
    <p id="cookie-desc" class="ui-description">
      <%= t(".description_html", privacy_policy: t(".privacy_policy")) %>
    </p>

    <!-- Actions -->
    <div class="ui-actions">

      <!-- Reject -->
      <button
        type="button"
        data-action="cookie-banner#reject"
        class="ui-button--secondary">
        <%= t(".reject_all") %>
      </button>

      <!-- Settings. A real document visit: cookie preferences live on the base host, so
           scripted location.assign (and an Inertia visit) are the wrong tool. -->
      <%= link_to t(".open_settings"), cookie_settings_url,
            class: "ui-button ui-button--secondary" %>

      <!-- Accept -->
      <button
        type="button"
        data-action="cookie-banner#accept"
        class="ui-button">
        <%= t(".accept_all") %>
      </button>

    </div>
  </div>
</div>
<% end %>
