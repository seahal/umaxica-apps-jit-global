<% hide_theme_controls =
     params[:action].to_s == "edit" &&
     (params[:preference_screen].to_s == "theme" ||
      controller_path.match?(%r{/preference/themes\z})) %>

<% unless hide_theme_controls %>
  <aside
    aria-labelledby="theme-title"
    class="ui-theme"
    data-controller="theme"
    data-theme-endpoint-url-value="<%= local_assigns.fetch(:endpoint_url) %>">
    <form>
      <fieldset class="ui-stack">

        <!-- Title -->
        <legend id="theme-title">
          <%= t(".title") %>
        </legend>

        <!-- Description -->
        <p class="ui-description">
          <%= t(".description") %>
        </p>

        <!-- Options -->
        <div class="ui-stack">

          <label class="ui-choice">
            <input
              type="radio"
              name="theme"
              value="system"
              data-action="change->theme#select">
            <span><%= t(".options.system") %></span>
          </label>

          <label class="ui-choice">
            <input
              type="radio"
              name="theme"
              value="light"
              data-action="change->theme#select">
            <span><%= t(".options.light") %></span>
          </label>

          <label class="ui-choice">
            <input
              type="radio"
              name="theme"
              value="dark"
              data-action="change->theme#select">
            <span><%= t(".options.dark") %></span>
          </label>

        </div>
      </fieldset>
    </form>
  </aside>
<% end %>
