<!DOCTYPE html>
<html lang="<%= get_language %>" data-theme="<%= theme_cookie_value %>" class="<%= theme_html_class %>" data-edition="org">
  <head>
    <meta charset="utf-8">
    <%= display_meta_tags site: "#{ENV.fetch("BRAND_NAME").upcase} (TECH ORG)",
                          title: page_title,
                          separator: "—",
                          reverse: true %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", nonce: true %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="ui-document">
    <%= render "shared/ui/skip_link" %>
    <header>
      <p><strong><%= link_to ENV.fetch("BRAND_NAME"), tech_org_root_path %></strong> <span>TECH (org)</span></p>
    </header>
    <main id="main" class="ui-main" tabindex="-1">
      <%= yield %>
    </main>
  </body>
</html>
