<!DOCTYPE html>
<html lang="<%= get_language %>" data-theme="<%= theme_cookie_value %>" class="<%= theme_html_class %>" data-edition="com">
<head>
  <meta charset="utf-8">
  <%= display_meta_tags site: "#{ENV.fetch("BRAND_NAME").upcase} (COM)",
                        title: page_title,
                        separator: "—",
                        reverse: true %>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", nonce: true %>
  <%= javascript_importmap_tags %>
</head>
<body class="ui-document">
  <%= render "shared/ui/skip_link" %>
  <header>
    <p><strong><%= link_to ENV.fetch("BRAND_NAME"), core_com_root_path %></strong> (com)</p>
  </header>

  <main id="main" class="ui-main" tabindex="-1">
    <%= yield %>
  </main>
</body>
</html>
