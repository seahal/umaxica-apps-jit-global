<!DOCTYPE html>
<html lang="<%= get_language %>" data-theme="<%= theme_cookie_value %>" class="<%= theme_html_class %>">
<head>
  <meta charset="utf-8">
  <%= display_meta_tags site: "#{ENV.fetch("BRAND_NAME").upcase} (ORG)",
                        title: page_title,
                        separator: "—",
                        reverse: true %>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <meta property="csp-nonce" nonce="<%= content_security_policy_nonce %>">
  <%= vite_stylesheet_tag "~/styles/surfaces/edit_org.css", nonce: true %>
  <%= javascript_importmap_tags %>
</head>
<body class="flex min-h-screen flex-col">
  <header class="sticky top-0 z-30 border-b border-line bg-surface/85 backdrop-blur">
    <div class="mx-auto flex w-full max-w-4xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6">
      <p class="flex flex-wrap items-baseline gap-x-2 text-base font-semibold text-fg">
        <%= link_to ENV.fetch("BRAND_NAME"), edit_org_root_path, class: "underline-offset-4 hover:underline" %>
        <span class="font-normal text-fg-muted">EDIT</span>
        <span class="text-sm font-normal text-fg-muted">(org)</span>
      </p>
    </div>
  </header>

  <main id="main" class="grow py-10 sm:py-14">
    <div class="mx-auto w-full max-w-4xl px-4 sm:px-6">
      <%= yield %>
    </div>
  </main>

  <footer class="mt-16 border-t border-line bg-canvas">
    <div class="mx-auto flex w-full max-w-4xl flex-col gap-6 px-4 py-8 sm:px-6">
      <nav aria-label="Footer">
        <%= link_to t("sign.org.preferences.footer.preference"),
              base_org_preference_url(host: ENV.fetch("PUBLIC_BASE_STAFF_URL"), ri: params[:ri]),
              class: "text-sm text-fg-muted underline-offset-4 hover:text-fg hover:underline" %>
      </nav>
      <p class="text-sm text-fg-muted">© <%= Time.zone.today.year %> <%= ENV.fetch("BRAND_NAME") %></p>
    </div>
  </footer>
</body>
</html>
