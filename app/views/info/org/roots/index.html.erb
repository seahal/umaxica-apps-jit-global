<!doctype html>
<%# A standalone document: it bypasses the surface layouts, so it links its own stylesheet and
    renders the theme attribute itself. Both were missing before, which is why the embedded CSS
    this replaced was refused by the style-src-elem policy and never applied. %>
<html lang="<%= I18n.locale %>"
      data-theme="<%= theme_cookie_value %>"
      data-edition="org">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= display_meta_tags site: "#{ENV.fetch("BRAND_NAME").upcase} (ORG)", separator: "—", reverse: true %>
    <%= vite_stylesheet_tag "~/styles/surfaces/info_org.css", nonce: true %>
  </head>
  <body>
    <main class="grid min-h-screen place-items-center px-4 py-10 sm:px-6 sm:py-14">
      <section aria-labelledby="info-org-title" class="w-full max-w-2xl">
        <h1 id="info-org-title" class="mb-3 text-3xl leading-snug font-bold text-fg sm:text-4xl">Info Org</h1>
        <p class="text-base text-fg-muted"><%= t("info.org.roots.message") %></p>
      </section>
    </main>
  </body>
</html>
