<!doctype html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= display_meta_tags site: "#{ENV.fetch("BRAND_NAME").upcase} (#{brand_tld})",
                          title: t("actions.continue"),
                          separator: "—",
                          reverse: true %>
    <%= render "shared/ui/standalone_ceremony_style" %>
  </head>
  <body>
    <main>
      <h1><%= t("actions.continue") %></h1>
      <%= form_with url: neutral_sign_form_url, method: :post, local: true do |form| %>
        <%= form.submit t("actions.continue") %>
      <% end %>
    </main>
  </body>
</html>
