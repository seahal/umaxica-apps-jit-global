<!doctype html>
<html lang="en">
  <head>
    <% content_for :page_title, I18n.t("sign.app.social.sessions.continue") %>
    <meta charset="utf-8">
    <meta name="robots" content="noindex,nofollow">
    <%= csrf_meta_tags %>
  </head>
  <body>
    <form id="oidc-authorization-handoff-form"
          method="post"
          action="<%= completion_url %>"
          data-turbo="false">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <%= hidden_field_tag :ri, ri if ri.present? %>
    </form>
    <button form="oidc-authorization-handoff-form" type="submit">Continue</button>
  </body>
</html>
