<% content_for :page_title, t("sign.shared.sign_out.title") %>

<div class="ui-page ui-page--narrow">
  <h1><%= title t("sign.shared.sign_out.title") %></h1>

  <% if sign_out_active_context_present? %>
    <p class="ui-description"><%= t("sign.shared.sign_out.confirm_description") %></p>
    <%= form_with url: sign_out_post_path, method: :post, data: { turbo: false } do %>
      <%= hidden_field_tag :logout_challenge, params[:logout_challenge] if params[:logout_challenge].present? %>
      <%= submit_tag t("sign.shared.sign_out.button"), class: "ui-button--danger" %>
      <noscript><p class="ui-description"><%= t("sign.shared.sign_out.confirm_description") %></p></noscript>
    <% end %>
    <%= button_to t("actions.cancel"),
                  sign_out_post_path,
                  method: :delete,
                  class: "ui-button--secondary",
                  form: { data: { turbo: false } } %>
  <% else %>
    <p class="ui-description"><%= t("sign.shared.sign_out.already_signed_out") %></p>
  <% end %>

  <p class="ui-description"><%= link_to t("sign.shared.sign_out.home_link"), sign_out_home_path %></p>
</div>
