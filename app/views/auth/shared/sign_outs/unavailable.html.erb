<% content_for :page_title, t("sign.shared.sign_out.unavailable_title") %>

<div class="ui-page ui-page--narrow">
  <h1><%= title t("sign.shared.sign_out.unavailable_title") %></h1>
  <p class="ui-description"><%= t("sign.shared.sign_out.unavailable_description") %></p>

  <%= form_with url: sign_out_confirmation_form_path, method: :post, data: { turbo: false } do %>
    <%= submit_tag t("sign.shared.sign_out.retry_button") %>
  <% end %>

  <p class="ui-description"><%= link_to t("sign.shared.sign_out.home_link"), sign_out_home_path %></p>
</div>
