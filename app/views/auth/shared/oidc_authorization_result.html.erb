<!doctype html>
<html lang="en">
  <head>
    <% content_for :page_title, I18n.t("sign.app.social.sessions.continue") %>
    <meta charset="utf-8">
    <meta name="robots" content="noindex,nofollow">
  </head>
  <body>
    <form id="oidc-authorization-result-form"
          method="post"
          action="<%= completion_url %>"
          data-turbo="false">
      <%= hidden_field_tag :result, result_token %>
      <%= hidden_field_tag :transaction_ref, transaction_ref %>
      <%= hidden_field_tag :ri, ri if ri.present? %>
    </form>
    <script nonce="<%= content_security_policy_nonce %>">
      (function () {
        const form = document.getElementById("oidc-authorization-result-form");
        if (form.requestSubmit) {
          form.requestSubmit();
        } else {
          form.submit();
        }
      })();
    </script>
    <noscript>
      <button form="oidc-authorization-result-form" type="submit">Continue</button>
    </noscript>
  </body>
</html>
