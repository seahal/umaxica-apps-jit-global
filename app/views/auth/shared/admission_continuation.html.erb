<!doctype html>
<html lang="en">
  <head>
    <% content_for :page_title, I18n.t("sign.app.social.sessions.continue") %>
    <meta charset="utf-8">
    <meta name="robots" content="noindex,nofollow">
  </head>
  <body>
    <form id="auth-admission-continuation-form"
          method="post"
          action="<%= action_url %>"
          data-turbo="false">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <%= hidden_field_tag reference_param, reference %>
      <%= hidden_field_tag :ri, ri if ri.present? %>
      <%= hidden_field_tag :pt, pt if pt.present? %>
    </form>
    <button form="auth-admission-continuation-form" type="submit">Continue</button>
  </body>
</html>
