<% page_title(title) %>
<div class="mx-auto flex w-full max-w-2xl flex-col gap-8">
  <div>
    <h1 class="text-2xl leading-snug font-semibold text-fg sm:text-3xl"><%= title %></h1>
    <% if description.present? %>
      <p class="text-base text-fg-muted"><%= description %></p>
    <% end %>
  </div>

  <% sections.each do |section| %>
    <section class="rounded-lg border border-line bg-surface p-4">
      <h2 class="mb-3 text-xl font-semibold text-fg"><%= section[:heading] %></h2>

      <% (section[:groups] || []).each do |group| %>
        <div class="mb-3 flex flex-col gap-1">
          <h3 class="text-lg font-semibold text-fg"><%= group[:heading] %></h3>
          <ul class="flex flex-col gap-1">
            <% group[:items].each do |item| %>
              <li class="text-base">
                <% if item[:href] %>
                  <%= link_to item[:label], item[:href], class: "inline-flex min-h-11 items-center text-link underline underline-offset-4 hover:underline",
                        aria: { label: "#{group[:heading]} #{item[:label]}" } %>
                <% else %>
                  <span class="text-fg-muted"><%= item[:label] %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if section[:items].present? %>
        <ul class="flex flex-col gap-1">
          <% section[:items].each do |item| %>
            <li class="text-base">
              <% if item[:href] %>
                <%= link_to item[:label], item[:href], class: "text-fg underline underline-offset-4 hover:underline" %>
              <% else %>
                <span class="text-fg-muted"><%= item[:label] %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>
</div>
