<% page_title(title) %>
<div class="mx-auto flex w-full max-w-4xl flex-col gap-8">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl leading-snug font-semibold text-fg sm:text-3xl"><%= title %></h1>
      <p class="text-base text-fg-muted"><%= description %></p>
    </div>
    <%= link_to "New entry", new_href,
          class: "inline-flex min-h-12 items-center justify-center rounded-md bg-accent px-3 py-2 text-base font-medium text-accent-fg" %>
  </div>

  <% if entries.empty? %>
    <p class="text-base text-fg-muted">No entries in this cell.</p>
  <% else %>
    <div tabindex="0" role="region" aria-label="<%= title %>" class="ui-table-scroll max-w-full overflow-x-auto rounded-xl border border-line">
    <table aria-label="<%= title %>" class="ui-table--dense w-full border-collapse bg-surface text-left text-sm [&_th]:px-3 [&_td]:px-3">
      <thead class="border-b-2 border-control">
        <tr class="text-fg">
          <th scope="col" class="py-2 pr-3 font-medium">Title</th>
          <th scope="col" class="py-2 pr-3 font-medium">Slug</th>
          <th scope="col" class="py-2 pr-3 font-medium">Locale</th>
          <th scope="col" class="py-2 pr-3 font-medium">Publication</th>
          <th scope="col" class="py-2 pr-3 font-medium">Revision</th>
          <th scope="col" class="py-2 pr-3 font-medium">Updated</th>
        </tr>
      </thead>
      <tbody>
        <% entries.each do |entry| %>
          <tr class="border-b border-line">
            <td class="py-2 pr-3">
              <%= link_to entry[:title] || entry[:public_id], entry[:show_href],
                    class: "text-fg underline underline-offset-4 hover:underline" %>
            </td>
            <td class="py-2 pr-3"><%= entry[:canonical_slug] || "—" %></td>
            <td class="py-2 pr-3"><%= entry[:locale] %></td>
            <td class="py-2 pr-3">
              <%= entry[:publication_state] %><%= " / archived" if entry[:archive_state] == "archived" %>
            </td>
            <td class="py-2 pr-3"><%= entry[:revision_sequence] || "—" %></td>
            <td class="py-2 pr-3"><%= entry[:updated_at] || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  <% end %>

  <nav aria-label="<%= t("ui_presentation.navigation.pagination") %>" class="flex items-center gap-3 text-base">
    <span class="text-fg-muted"><%= page[:total] %> entries · page <%= page[:number] %></span>
    <%= link_to "Previous", page[:previous_href] if page[:previous_href] %>
    <%= link_to "Next", page[:next_href] if page[:next_href] %>
  </nav>
</div>
