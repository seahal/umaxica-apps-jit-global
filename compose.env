# Environment shared by the two ways this repository is run:
#
#   * the Dev Container's `core` service   (.devcontainer/compose.yaml)
#   * the plain-Compose `app` service      (compose.yaml, profile `app`)
#
# Both read this file with `env_file:`. It exists because a YAML anchor cannot
# cross a Compose file boundary, and `core` and `app` live in different files by
# design -- `core` must not start on a bare `podman compose up`.
#
# Everything here is a development-only fixed literal. Nothing in it is a
# secret: every database it names is disposable and nothing is reachable off
# the host. Values that support a host override (`${VAR:-default}`) are NOT
# here -- `env_file` performs no interpolation -- and stay in the
# `environment:` block of both services instead.
#
# Hostnames are Compose service names (`primary`, `replica`, `valkey-cache`,
# `alloy`, `fakecloud`), so this file is only correct from inside the project
# network.

# The datastores run on UTC; keep the app container consistent with them.
# A host `/etc/timezone` bind mount is not portable: the file is a Debian
# convention and does not exist on Fedora/RHEL hosts, where the missing
# source made the whole container fail to create.
TZ=UTC
# Pinned here as well as in the image (Containerfile, `development-base`), because
# anything that rebuilds the container environment rather than inheriting PID 1's
# -- a different build target, a base image change -- otherwise leaves Ruby at
# Encoding.default_external US-ASCII, where reading any non-ASCII source raises
# `invalid byte sequence in US-ASCII` from tests that only scan files.
LANG=C.UTF-8
LC_ALL=C.UTF-8
# --- Ruby / Bundler ---
RUBY_PATH=/usr/local/bin/ruby
BUNDLE_PATH=vendor/bundle
# --- Rails server ---
BRAND_NAME=UMAXICA
PORT=3000
BINDING=0.0.0.0
# `alloy` is no longer profile-gated, so it is always there to receive.
# Leaving this "false" would run the whole collection stack while Rails
# itself emitted nothing.
OPEN_TELEMETRY=true
NODE_ENV=development
# --- PostgreSQL credentials ---
# Fixed literals, not generated secrets. This stack is development-only,
# every database it serves is disposable, and nothing here is reachable
# off the host, so a value the whole team can read from the file it is
# written in is worth more than a random one nobody can look up. Keep
# these three identical to the `primary` and `replica` values below;
# PostgreSQL bakes the password into `primary-data` at initdb time, so a
# mismatch locks the stack out of its own volume.
POSTGRESQL_USER=root
POSTGRESQL_PASSWORD=development
POSTGRESQL_DATABASE=db

# --- PostgreSQL topology ---
# One `_PUB` (writer) and one `_SUB` (reader) entry per development
# database in config/database.yml, which reads them with one-argument
# ENV.fetch: a name missing here fails the boot instead of silently
# routing that database at the default host. `primary` has no replica
# entry, so it is writer-only. Keep this list in step with the
# `development:` block of config/database.yml.
POSTGRESQL_HOST=primary
POSTGRESQL_PORT=5432
POSTGRESQL_APP_ZENITH_PUB=primary
POSTGRESQL_APP_ZENITH_SUB=replica
POSTGRESQL_ORG_ZENITH_PUB=primary
POSTGRESQL_ORG_ZENITH_SUB=replica
POSTGRESQL_COM_ZENITH_PUB=primary
POSTGRESQL_COM_ZENITH_SUB=replica
POSTGRESQL_APP_SETTING_PUB=primary
POSTGRESQL_APP_SETTING_SUB=replica
POSTGRESQL_ORG_SETTING_PUB=primary
POSTGRESQL_ORG_SETTING_SUB=replica
POSTGRESQL_COM_SETTING_PUB=primary
POSTGRESQL_COM_SETTING_SUB=replica
POSTGRESQL_APP_TICKET_PUB=primary
POSTGRESQL_APP_TICKET_SUB=replica
POSTGRESQL_ORG_TICKET_PUB=primary
POSTGRESQL_ORG_TICKET_SUB=replica
POSTGRESQL_COM_TICKET_PUB=primary
POSTGRESQL_COM_TICKET_SUB=replica
POSTGRESQL_APP_SIGNAL_PUB=primary
POSTGRESQL_APP_SIGNAL_SUB=replica
POSTGRESQL_ORG_SIGNAL_PUB=primary
POSTGRESQL_ORG_SIGNAL_SUB=replica
POSTGRESQL_COM_SIGNAL_PUB=primary
POSTGRESQL_COM_SIGNAL_SUB=replica
POSTGRESQL_AVATAR_PUB=primary
POSTGRESQL_AVATAR_SUB=replica
POSTGRESQL_CHRONICLE_PUB=primary
POSTGRESQL_CHRONICLE_SUB=replica
POSTGRESQL_OCCURRENCE_PUB=primary
POSTGRESQL_OCCURRENCE_SUB=replica
POSTGRESQL_PUBLISHING_PUB=primary
POSTGRESQL_PUBLISHING_SUB=replica
POSTGRESQL_QUEUE_PUB=primary
POSTGRESQL_QUEUE_SUB=replica
POSTGRESQL_SEARCH_PUB=primary
POSTGRESQL_SEARCH_SUB=replica
POSTGRESQL_STORAGE_PUB=primary
POSTGRESQL_STORAGE_SUB=replica
POSTGRESQL_PRIMARY_PUB=primary
# --- Valkey ---
# Two services, not two logical database indexes on one. The stores have
# different lifetimes and different blast radiuses: flushing the cache to
# reproduce a stale-JWKS bug must not also reset every rate-limit window,
# and restarting either must not take the other down. A shared container
# with /0 and /1 makes both of those one `FLUSHALL` or one restart away.
#
# Neither is authoritative. Losing the cache costs a refetch; losing the
# counters resets the current windows. Anything whose loss would change
# correctness, security, or history is in PostgreSQL.
CACHE_REDIS_URL=redis://valkey-cache:6379/0
RATE_LIMIT_REDIS_URL=redis://valkey-rate-limit:6379/0

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# --- Mail ---
AWS_SES_REGION=ap-northeast-1
# --- Object storage (fakecloud S3) ---
OBJECT_STORAGE_ENDPOINT=http://fakecloud:4566
OBJECT_STORAGE_REGION=us-east-1
# Fixed development bucket name, like the endpoint and region above. It is
# not host-shaped and not a credential, so it belongs in the service
# contract rather than in the repository-root .env.
OBJECT_STORAGE_BUCKET=umaxica-local
# fakecloud validates the shape of a SigV4 signature but never the key
# material, so these are not secrets and the former Podman-secret machinery
# bought nothing. Literal, obviously-fake values are the point: a real AWS
# access key appearing here is visible on sight rather than hidden behind a
# generated /run/secrets file. Production takes no key from these variables
# at all -- it uses the AWS SDK default credential chain and rejects
# OBJECT_STORAGE_ENDPOINT outright (lib/object_storage_shrine_configuration.rb).
OBJECT_STORAGE_ACCESS_KEY_ID=test
OBJECT_STORAGE_SECRET_ACCESS_KEY=test
OBJECT_STORAGE_FORCE_PATH_STYLE=true
PUBLIC_AUTH_CORPORATE_URL=auth.umaxica.com
PUBLIC_AUTH_SERVICE_URL=auth.umaxica.app
PUBLIC_AUTH_STAFF_URL=auth.umaxica.org
PUBLIC_BASE_CORPORATE_URL=www.umaxica.com
PUBLIC_BASE_SERVICE_URL=www.umaxica.app
PUBLIC_BASE_STAFF_URL=www.umaxica.org
PUBLIC_EDIT_STAFF_URL=edit.umaxica.org
PRIVATE_EDIT_STAFF_URL=edit.org.localhost
PUBLIC_BASE_DEVELOPER_URL=www.umaxica.dev
PUBLIC_SIDE_CORPORATE_URL=www-jp.umaxica.com
PUBLIC_SIDE_SERVICE_URL=www-jp.umaxica.app
PUBLIC_SIDE_STAFF_URL=www-jp.umaxica.org
PUBLIC_CORE_CORPORATE_URL=jp.umaxica.com
PUBLIC_CORE_SERVICE_URL=jp.umaxica.app
PUBLIC_CORE_STAFF_URL=jp.umaxica.org
PUBLIC_PALM_SERVICE_URL=palm-jp.umaxica.app
PUBLIC_INFO_CORPORATE_URL=info.umaxica.com
PUBLIC_INFO_SERVICE_URL=info.umaxica.app
PUBLIC_INFO_STAFF_URL=info.umaxica.org
PUBLIC_GUID_SERVICE_URL=guid.umaxica.net
PUBLIC_DOCS_CORPORATE_URL=docs.com.localhost
PUBLIC_DOCS_SERVICE_URL=docs.app.localhost
PUBLIC_DOCS_STAFF_URL=docs.org.localhost
PUBLIC_EDGE_CORPORATE_URL=edge.com.localhost
PUBLIC_EDGE_SERVICE_URL=edge.app.localhost
PUBLIC_EDGE_STAFF_URL=edge.org.localhost
PUBLIC_JUMP_GATEWAY_URL=jump.umaxica.net
PUBLIC_STATUS_URL=status.umaxica.dev
PUBLIC_ASSET_URL=asset.umaxica.net
# --- Private origins (pod-internal / tunnel) ---
PRIVATE_AUTH_CORPORATE_URL=auth.com.localhost
PRIVATE_AUTH_SERVICE_URL=auth.app.localhost
PRIVATE_AUTH_STAFF_URL=auth.org.localhost
PRIVATE_BASE_CORPORATE_URL=base.com.localhost
PRIVATE_BASE_SERVICE_URL=base.app.localhost
PRIVATE_BASE_STAFF_URL=base.org.localhost
PRIVATE_BASE_NETWORK_URL=base.net.localhost
PRIVATE_BASE_DEVELOPER_URL=base.dev.localhost
PRIVATE_CORE_CORPORATE_URL=core.com.localhost
PRIVATE_CORE_SERVICE_URL=core.app.localhost
PRIVATE_CORE_STAFF_URL=core.org.localhost
PRIVATE_DOCS_CORPORATE_URL=docs.com.localhost
PRIVATE_DOCS_SERVICE_URL=docs.app.localhost
PRIVATE_DOCS_STAFF_URL=docs.org.localhost
PRIVATE_HELP_CORPORATE_URL=help.com.localhost
PRIVATE_HELP_SERVICE_URL=help.app.localhost
PRIVATE_HELP_STAFF_URL=help.org.localhost
PRIVATE_INFO_CORPORATE_URL=info.com.localhost
PRIVATE_INFO_SERVICE_URL=info.app.localhost
PRIVATE_INFO_STAFF_URL=info.org.localhost
PRIVATE_GUID_SERVICE_URL=guid.net.localhost
PRIVATE_NEWS_CORPORATE_URL=news.com.localhost
PRIVATE_NEWS_SERVICE_URL=news.app.localhost
PRIVATE_NEWS_STAFF_URL=news.org.localhost
PRIVATE_PALM_SERVICE_URL=palm.app.localhost
# --- External authentication ceremony availability ---
# Now runtime Flipper features (:social_ceremony_apple / _google / _entra) stored in
# the `primary` PostgreSQL database. Enable them with `bin/rails social_ceremony:enable[apple]`.
# --- JWT leeway ---
AUTH_JWT_CLIENT_AUDIENCES=umaxica-api-client
AUTH_JWT_VISITOR_AUDIENCES=umaxica-api-visitor
AUTH_JWT_OPERATOR_AUDIENCES=umaxica-api-operator
AUTH_JWT_CLIENT_CLIENT_ID=umaxica-web-client
AUTH_JWT_VISITOR_CLIENT_ID=umaxica-web-visitor
AUTH_JWT_OPERATOR_CLIENT_ID=umaxica-web-operator
PREFERENCE_JWT_CLIENT_ID=umaxica-preference-web
# --- Vite ---
VITE_RUBY_PACKAGE_MANAGER=pnpm
VITE_RUBY_HOST=0.0.0.0
VITE_RUBY_PORT=3036
VITE_GIT_HOOKS=0
# --- pnpm ---
# Pin the store instead of letting pnpm resolve it: node_modules lives on its
# own named volume, so pnpm's default resolution falls back to a workspace-local
# .pnpm-store, which conflicts with the store vite-ruby's own pnpm calls used and
# fails every session with ERR_PNPM_UNEXPECTED_STORE.
npm_config_store_dir=/home/global/.local/share/pnpm/store
TMPDIR=/home/global/workspace/tmp
RUBY_DEBUG_OPEN=false
