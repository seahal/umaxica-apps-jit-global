# Podman uses .containerignore in preference to .dockerignore. This file is
# intentionally kept byte-for-byte equivalent to .dockerignore so both Podman
# and Docker-compatible builders exclude the same repository content.

# Git
.git
.gitignore
.gitattributes

# Documentation
README.md
CHANGELOG.md
LICENSE
doc/
docs/
*.md

# Development files
.devcontainer/
!.devcontainer/
.devcontainer/*
# ...except the two files the image bakes for the opt-in remote-access overlay.
# They live under .devcontainer/ because umaxica-apps-edge and portal keep their
# copies there too, and the three are meant to stay byte-comparable.
!.devcontainer/remote-sshd_config
!.devcontainer/remote-sshd-entrypoint.sh
!.devcontainer/tailscale-wrapper.sh
.vscode/
.idea/

# Environment files
.env*
!.env.example
!.env*.erb

# Local credentials are excluded independently of Git. Keep this synchronized
# with .dockerignore for Docker-compatible builders.
.secrets/

# Security files
config/master.key
config/credentials/*.key

# Log files and temp files
log/*
!log/.keep
tmp/*
!tmp/.keep
tmp/pids/*
!tmp/pids/.keep

# Storage (uploaded files)
storage/*
!storage/.keep
tmp/storage/*
!tmp/storage/.keep

# Dependencies
.bundle
.bun/

# Assets and builds
app/assets/builds/*
!app/assets/builds/.keep
public/assets
!public/assets/.manifest.json
public/packs/
public/packs-test/
# Vite output is produced by the production-assets stage. Copying a host build in would ship
# whatever the developer last compiled, including a development-mode React bundle.
public/vite
public/vite-dev
public/vite-test

# Test and coverage
test/
spec/
coverage/
.simplecov

# Development databases
*.sqlite3
*.sqlite3-*

# Caches and generated files
.sass-cache/
.byebug_history
.ruby-lsp/
.wrangler/
.crush/
.claude/
.codex/
.gnupg/
.ssh/
dependency/
memo/
node_modules/
.npm/
.eslintcache
build/
dist/
*.tsbuildinfo

# OS and editor files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~
*.swp
*.swo
*#
.#*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Repository build definitions and Compose configuration
Dockerfile*
Containerfile*
docker-compose*
compose.yaml
docker/
podman/
!podman/
podman/*
!podman/core/
podman/core/*
!podman/core/entrypoint.sh
!podman/core/dev-supervisor.sh
!podman/core/desktop.sh
!podman/core/sshd_config
gke/

# CI
.github/
.gitlab-ci.yml
.travis.yml
.circleci/
