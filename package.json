{
  "name": "umaxica-app-jit",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt src spec e2e app/views/pwa *.ts *.json *.yaml *.yml",
    "format:check": "oxfmt --check src spec e2e app/views/pwa *.ts *.json *.yaml *.yml",
    "typecheck": "tsc --build",
    "build": "NODE_ENV=production vite build --mode production",
    "check": "bun run format:check && bun run lint && bun run typecheck:verify && bun run typecheck && bun run deadcode && bun run openapi:lint && bun run openapi:verify",
    "ci": "bun run check && bun run test:coverage && bun run build",
    "ci:js": "bun run ci",
    "fix": "bun run format && bun run lint:fix",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "test:e2e": "playwright test",
    "deadcode": "knip",
    "typecheck:verify": "tsc -p tsconfig.app.json --noEmit --listFiles | grep -q '/src/' || (echo 'typecheck covered no source files' >&2 && exit 1)",
    "openapi:lint": "redocly lint",
    "openapi:bundle": "redocly bundle",
    "openapi:verify": "bun run openapi:bundle && git diff --exit-code -- openapi/bundled/openapi.app.yml openapi/bundled/openapi.com.yml openapi/bundled/openapi.org.yml"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@inertiajs/core": "3.7.1",
    "@inertiajs/react": "^3.7.1",
    "@inertiajs/vite": "^3.7.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@redocly/cli": "^2.53.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.1",
    "@vitest/browser-playwright": "5.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "^30.1.0",
    "knip": "^6.37.0",
    "lefthook": "2.1.14",
    "linkinator": "^8.1.0",
    "oxc-transform-react": "^0.150.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "playwright": "^1.63.0",
    "tailwindcss-react-aria-components": "^2.2.0",
    "vite": "8.3.0",
    "vite-plugin-ruby": "^5.2.4",
    "vitest": "5.0.1"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.19.0 <25"
  },
  "packageManager": "bun@1.4.0"
}
