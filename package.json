{
  "name": "umaxica-app-jit",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt src spec e2e app/views/pwa *.ts *.json *.yaml *.yml",
    "format:check": "oxfmt --check src spec e2e app/views/pwa *.ts *.json *.yaml *.yml",
    "typecheck": "tsc --build",
    "build": "NODE_ENV=production vite build --mode production",
    "check": "pnpm --loglevel silent run format:check && pnpm --loglevel silent run lint && pnpm --loglevel silent run typecheck:verify && pnpm --loglevel silent run typecheck && pnpm --loglevel silent run deadcode && pnpm --loglevel silent run openapi:lint && pnpm --loglevel silent run openapi:verify",
    "ci": "pnpm --loglevel silent run check && pnpm --loglevel silent run test:coverage && pnpm --loglevel silent run build",
    "ci:js": "pnpm --loglevel silent run ci",
    "fix": "pnpm --loglevel silent run format && pnpm --loglevel silent run lint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "deadcode": "knip",
    "typecheck:verify": "tsc -p tsconfig.app.json --noEmit --listFiles | grep -q '/src/' || (echo 'typecheck covered no source files' >&2 && exit 1)",
    "openapi:lint": "redocly lint",
    "openapi:bundle": "redocly bundle",
    "openapi:verify": "pnpm --loglevel silent run openapi:bundle && git diff --exit-code -- public/openapi.app.yml public/openapi.com.yml public/openapi.org.yml"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@inertiajs/core": "3.7.0",
    "@inertiajs/react": "^3.7.0",
    "@inertiajs/vite": "^3.7.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@redocly/cli": "^2.49.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "lefthook": "catalog:",
    "linkinator": "^8.1.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "^1.62.1",
    "tailwindcss-react-aria-components": "^2.2.0",
    "vite": "catalog:",
    "vite-plugin-ruby": "^5.2.3",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.0.0+sha512.9e2e3dc3911995868dc94b8175c217c27e95408fa03b4a22749778f2b34f773b77cdd3b39ede8171b22fcd53be6a35342e9fac9948a68ef58df6488ce89a7e67"
}
