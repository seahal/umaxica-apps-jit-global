# Umaxica Global local development contract (non-secret defaults).
# Rails reads this automatically when .env is absent. Override locally in .env;
# never put production credentials or tokens in this file.
# Host-native Rails uses loopback. Dev Containers bootstrap .env from
# .env.devcontainer.example so application settings stay independent of Compose.
NODE_ENV=development
RAILS_MAX_THREADS=3
PORT=3000
BINDING=0.0.0.0
BRAND_NAME=UMAXICA
TMPDIR=/home/global/workspace/tmp
BUNDLE_PATH=vendor/bundle
VITE_RUBY_HOST=0.0.0.0
VITE_RUBY_PORT=3036
VITE_RUBY_PACKAGE_MANAGER=bun
VITE_GIT_HOOKS=0
POSTGRESQL_HOST=primary
POSTGRESQL_PORT=5432
POSTGRESQL_USER=root
POSTGRESQL_PASSWORD=development
POSTGRESQL_DATABASE=db
POSTGRESQL_TEST_HOST=primary
POSTGRESQL_APP_ZENITH_PUB=primary
POSTGRESQL_APP_ZENITH_SUB=replica
POSTGRESQL_ORG_ZENITH_PUB=primary
POSTGRESQL_ORG_ZENITH_SUB=replica
POSTGRESQL_COM_ZENITH_PUB=primary
POSTGRESQL_COM_ZENITH_SUB=replica
POSTGRESQL_APP_SETTING_PUB=primary
POSTGRESQL_APP_SETTING_SUB=replica
POSTGRESQL_ORG_SETTING_PUB=primary
POSTGRESQL_ORG_SETTING_SUB=replica
POSTGRESQL_COM_SETTING_PUB=primary
POSTGRESQL_COM_SETTING_SUB=replica
POSTGRESQL_APP_TICKET_PUB=primary
POSTGRESQL_APP_TICKET_SUB=replica
POSTGRESQL_ORG_TICKET_PUB=primary
POSTGRESQL_ORG_TICKET_SUB=replica
POSTGRESQL_COM_TICKET_PUB=primary
POSTGRESQL_COM_TICKET_SUB=replica
POSTGRESQL_APP_SIGNAL_PUB=primary
POSTGRESQL_APP_SIGNAL_SUB=replica
POSTGRESQL_ORG_SIGNAL_PUB=primary
POSTGRESQL_ORG_SIGNAL_SUB=replica
POSTGRESQL_COM_SIGNAL_PUB=primary
POSTGRESQL_COM_SIGNAL_SUB=replica
POSTGRESQL_AVATAR_PUB=primary
POSTGRESQL_AVATAR_SUB=replica
POSTGRESQL_CHRONICLE_PUB=primary
POSTGRESQL_CHRONICLE_SUB=replica
POSTGRESQL_OCCURRENCE_PUB=primary
POSTGRESQL_OCCURRENCE_SUB=replica
POSTGRESQL_PUBLISHING_PUB=primary
POSTGRESQL_PUBLISHING_SUB=replica
POSTGRESQL_QUEUE_PUB=primary
POSTGRESQL_SEARCH_PUB=primary
POSTGRESQL_SEARCH_SUB=replica
POSTGRESQL_STORAGE_PUB=primary
POSTGRESQL_STORAGE_SUB=replica
POSTGRESQL_PRIMARY_PUB=primary
# Databases that `db:test:prepare` is allowed to migrate. DatabaseSafety fetches this
# name with no default, so `bin/rails test` aborts before any schema work when it is
# unset -- the guard is deliberate: an implicit default could migrate a database the
# run was never meant to touch. This value is the repository's canonical test scope and
# matches the `db:test:prepare` step in config/ci.rb; keep the two in step.
POSTGRESQL_TEST_PREPARE_DATABASES=test_primary_db,test_app_ticket_db,test_com_ticket_db,test_org_ticket_db
# Canonical nonprod Valkey endpoints (Compose DNS). config/valkey.yml binds
# responsibilities to these hosts and logical DBs. Do not also set
# CACHE_/RATE_LIMIT_/AUTH_STATE_REDIS_URL here; those names are production URL keys.
VALKEY_CACHE_HOST=valkey-cache
VALKEY_CACHE_PORT=6379
VALKEY_KVS_HOST=valkey-kvs
VALKEY_KVS_PORT=6379
VALKEY_DIAGNOSTIC_HOST=valkey
VALKEY_DIAGNOSTIC_PORT=6379
OBJECT_STORAGE_ENDPOINT=http://fakecloud:4566
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET_AVATAR=umaxica-avatar-development
OBJECT_STORAGE_BUCKET_PUBLISHING=umaxica-publishing-development
OBJECT_STORAGE_ACCESS_KEY_ID=test
OBJECT_STORAGE_SECRET_ACCESS_KEY=test
OBJECT_STORAGE_FORCE_PATH_STYLE=true
AWS_SES_REGION=ap-northeast-1
SMS_PROVIDER=test
EMAIL_ADDRESS_HMAC_SALT=development_email_address_hmac_salt
TELEPHONE_NUMBER_HMAC_SALT=development_telephone_number_hmac_salt
ENFORCEMENT_APP_IDENTIFIER_HMAC_KEY=development_enforcement_app_identifier_hmac_key
ENFORCEMENT_COM_IDENTIFIER_HMAC_KEY=development_enforcement_com_identifier_hmac_key
ENFORCEMENT_ORG_IDENTIFIER_HMAC_KEY=development_enforcement_org_identifier_hmac_key
