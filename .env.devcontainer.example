DEVCONTAINER=1
OPEN_TELEMETRY=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
PUBLIC_EDGE_CORPORATE_URL=edge.com.localhost
PUBLIC_EDGE_SERVICE_URL=edge.app.localhost
PUBLIC_EDGE_STAFF_URL=edge.org.localhost
# --- Jump gateway --------------------------------------------------------------
# PUBLIC_JUMP_GATEWAY_URL is the only Jump gateway setting: the browser-facing public HTTPS
# root origin, with no default. The gateway JWKS URI (<origin>/.well-known/jwks.json) and the
# Jump RT audience (the origin itself) are derived from it and cannot be configured separately.
# The removed settings JUMP_GATEWAY_URL, *_JWKS_URL and *_AUDIENCE are rejected at boot if
# present. PRIVATE_JUMP_GATEWAY_URL fails boot if set (even empty): Rails has no private path to Jump.
# Each Jump issuer identity (and its return origin and JWKS URI) comes from the existing
# PUBLIC_{AUTH,BASE,CORE,WARP}_{SERVICE,CORPORATE,STAFF}_URL and PUBLIC_PALM_SERVICE_URL values;
# there are no Jump-specific issuer or development key settings. Rails.env does not change the
# identity: when development uses a canonical origin, that origin's /.well-known/jwks.json must
# publish the local key from tmp/local_jwt_keysets.json, and that key then signs as the
# canonical issuer. localhost and private ingress names are never Jump identities. A Jump
# emulator is not implemented; a future one needs its own explicit security contract.
PUBLIC_JUMP_GATEWAY_URL=https://jump.umaxica.net
# --- Diagnostic surfaces -----------------------------------------------------
# Three development-only dashboards, each on its own dedicated host behind HTTP
# Basic Auth. See adr/diagnostic-surfaces-performance-coverband-swagger.md.
#
# PUBLIC_* is the name a browser sees; PRIVATE_* is the network-side ingress the
# Cloudflare Tunnel connector reaches. Both are exact FQDNs -- no wildcard is
# admitted anywhere, so a spoofed Host cannot reach one dashboard through
# another's name.
PUBLIC_PERFORMANCE_URL=performance.umaxica.dev
PRIVATE_PERFORMANCE_URL=performance.core.dev.localhost
PUBLIC_COVERBAND_URL=coverband.umaxica.dev
PRIVATE_COVERBAND_URL=coverband.core.dev.localhost
PUBLIC_SWAGGER_URL=swagger.umaxica.dev
PRIVATE_SWAGGER_URL=swagger.core.dev.localhost

# Diagnostic dashboards stay on VALKEY_DIAGNOSTIC_HOST (compatibility `valkey`).
# Logical DBs 12/13 are declared in config/valkey.yml. Do not point Coverband
# or rails_performance at cache or KVS.

# Read through Rails.app.creds.option, which checks ENV first and then Rails
# credentials. Left unset, each surface answers 401 -- the guards fail closed.
RAILS_PERFORMANCE_USERNAME=
RAILS_PERFORMANCE_PASSWORD=
COVERBAND_USERNAME=
COVERBAND_PASSWORD=
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# Optional per-surface switches. Both default to on. Only the exact string
# "false" disables, so a typo cannot silently turn observability off.
# Swagger has no toggle of its own: unset its PUBLIC_/PRIVATE_ pair above and
# the host drops out of both the route constraint and Host Authorization.
RAILS_PERFORMANCE_ENABLED=true
COVERBAND_ENABLED=true
