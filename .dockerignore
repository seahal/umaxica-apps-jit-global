# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Git
.git
.gitignore
.gitattributes

# Documentation
README.md
CHANGELOG.md
LICENSE
doc/
docs/
*.md

# Development files
.devcontainer/
!.devcontainer/
.devcontainer/*
# ...except the two files the image bakes for the opt-in remote-access overlay.
# They live under .devcontainer/ because umaxica-apps-edge and portal keep their
# copies there too, and the three are meant to stay byte-comparable.
!.devcontainer/remote-sshd_config
!.devcontainer/remote-sshd-entrypoint.sh
!.devcontainer/tailscale-wrapper.sh
.vscode/
.idea/

# Environment files
.env*
!.env.example
!.env*.erb

# Local credentials are excluded independently of Git. Keep this synchronized
# with .containerignore because Podman prefers that file when both exist.
.secrets/

# Security files
config/master.key
config/credentials/*.key

# Log files and temp files
log/*
!log/.keep
tmp/*
!tmp/.keep
tmp/pids/*
!tmp/pids/.keep

# Storage (uploaded files)
storage/*
!storage/.keep
tmp/storage/*
!tmp/storage/.keep

# Dependencies
#vendor/cache/
.bundle
.bun/
# The asset stage installs from pnpm-lock.yaml; a host node_modules would carry the wrong
# platform binaries into the build and defeat the lockfile pinning.
node_modules/

# Assets and builds
app/assets/builds/*
!app/assets/builds/.keep
public/assets
!public/assets/.manifest.json
public/packs/
public/packs-test/
# Vite output is produced by the production-assets stage. Copying a host build in would ship
# whatever the developer last compiled, including a development-mode React bundle.
public/vite
public/vite-dev
public/vite-test

# Test files
test/
gait/
coverage/
.simplecov

# Development databases
*.sqlite3
*.sqlite3-*

# Cache
.sass-cache/
.byebug_history

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
*~
*.swp
*.swo
*#
.#*

# Ruby
*.gem
.rbenv-gemsets

# JavaScript/TypeScript
npm-debug.log*
yarn-debug.log*
yarn-error.log*
jspm_packages/
.npm
.eslintcache
build/
dist/
*.tsbuildinfo
.node_repl_history
*.tgz
.yarn-integrity

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.lcov

# Compiled binary addons
build/Release/

# Docker
Dockerfile*
docker-compose*
compose.yaml
compose.yaml
docker/
podman/
!podman/
podman/*
!podman/core/
podman/core/*
!podman/core/entrypoint.sh
!podman/core/dev-supervisor.sh
!podman/core/desktop.sh
!podman/core/sshd_config
gke/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
.circleci/

# Local caches and tooling
.ruby-lsp/
.wrangler/
.crush/
.claude/
dependency/
memo/


#
.ruby-lsp
.cache
.claude.json
.claude.json.backup
.codex
.gnupg
.irb_history
.ssh
.vscode-server
qodana.yaml
wrangler.jsonc
