// Grafana Alloy — the single observability agent for this repository.
//
// adr/traces-and-metrics-routing-via-alloy.md makes Alloy the only agent and
// retires the standalone `otel-collector`. Alloy is an OpenTelemetry Collector
// distribution that additionally carries native Prometheus pipelines, so the
// former collector (OTLP receive) and the former Prometheus scrape job
// (`otel-collector:8889`) collapse into this one process.
//
// Routing, per that ADR:
//   Rails --OTLP--> alloy --> tempo       (traces)
//                         --> prometheus  (metrics, via remote_write)
//   log files ----> alloy --> loki        (logs, by file tail)
//
// Alloy is the only ingestion gateway: Rails never writes to Tempo, Prometheus
// or Loki directly, so every signal passes the agent-side redaction below.
// Logs were out of scope in the original decision; the amendment to
// adr/application-logging-boundary.md added the file-tail path and left the
// Lograge / Rails.logger / audit-record split untouched.

// ----------------------------------------------------------------------------
// Receive
// ----------------------------------------------------------------------------
// Both protocols are bound because the Ruby OTLP exporter defaults to HTTP
// (4318) while most infrastructure exporters speak gRPC (4317). Binding
// 0.0.0.0 is the container-side listener only; no host port is published, so
// this stays on the `observability` network. See
// docs/operations/development-host-port-exposure.md.
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces  = [otelcol.processor.attributes.redact.input]
    metrics = [otelcol.processor.attributes.redact.input]
  }
}

// ----------------------------------------------------------------------------
// Redact (second of two stages)
// ----------------------------------------------------------------------------
// The application already scrubs these keys in-process
// (lib/observability_span_scrubber.rb). This repeats the work on the agent side
// as defense in depth: a new instrumentation that forgets to filter, or a new
// attribute added by an upstream gem, is caught here rather than reaching
// storage. The ADR requires both stages to stay in sync — this list mirrors
// ObservabilitySpanScrubber::SENSITIVE_ATTRIBUTE_KEYS, and a change to one is a
// defect unless the other changes with it.
//
// `delete` rather than `hash`: a hash of a session cookie is still a stable
// per-user identifier, so hashing would keep the correlation risk the ADR is
// trying to remove.
otelcol.processor.attributes "redact" {
  action {
    key    = "http.url"
    action = "delete"
  }

  action {
    key    = "http.target"
    action = "delete"
  }

  action {
    key    = "http.request.body"
    action = "delete"
  }

  action {
    key    = "url"
    action = "delete"
  }

  action {
    key    = "uri"
    action = "delete"
  }

  action {
    key    = "request_uri"
    action = "delete"
  }

  action {
    key    = "original_url"
    action = "delete"
  }

  action {
    key    = "query_string"
    action = "delete"
  }

  // Catches every `http.request.header.authorization`,
  // `http.response.header.set-cookie`, bare `cookie`, and any future
  // attribute whose name carries either word. The in-process scrubber applies
  // the same substring rule.
  action {
    pattern = ".*(authorization|cookie).*"
    action  = "delete"
  }

  action {
    pattern = "^(token|access_token|id_token|refresh_token)$"
    action  = "delete"
  }

  output {
    traces  = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
  }
}

// ----------------------------------------------------------------------------
// Batch
// ----------------------------------------------------------------------------
// Matches the timeout the retired otel-collector used, so the change of agent
// does not also change export cadence.
otelcol.processor.batch "default" {
  timeout = "10s"

  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}

// ----------------------------------------------------------------------------
// Export: traces to Tempo
// ----------------------------------------------------------------------------
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    // Plaintext on a container-only network. Nothing on the host can dial
    // either end, and issuing certificates for a development stack would add a
    // trust store to maintain for no boundary gained.
    tls {
      insecure = true
    }
  }
}

// ----------------------------------------------------------------------------
// Export: metrics to Prometheus
// ----------------------------------------------------------------------------
// Alloy converts OTLP metrics to Prometheus form and pushes them. This replaces
// the former arrangement where the collector exposed :8889 and Prometheus
// scraped it, so `podman/prometheus/prometheus.yml` no longer carries an
// `otel-collector` scrape job. Prometheus must run with
// `--web.enable-remote-write-receiver`; it rejects remote_write otherwise.
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.local.receiver]
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// ----------------------------------------------------------------------------
// Self-monitoring
// ----------------------------------------------------------------------------
// Alloy's own metrics. Without this the agent is the one unobserved hop in the
// pipeline, so a silently failing exporter looks identical to an application
// that emitted nothing.
prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy" {
  targets    = prometheus.exporter.self.alloy.targets
  forward_to = [prometheus.remote_write.local.receiver]
}

// ----------------------------------------------------------------------------
// Receive: logs from files
// ----------------------------------------------------------------------------
// Logs reach Loki through this agent and no other. Rails writes files; Alloy
// tails them. The alternatives were weighed in
// adr/application-logging-boundary.md ("Amendment: development logs reach Loki
// by file tail"):
//
//   stdout piping   — host-native Rails' stdout is a terminal on the host. A
//                     container cannot read it, so the transport that works in
//                     the Dev Container does not work in the primary topology.
//   journald        — host-native Rails under `bin/dev` is not a systemd unit,
//                     and mounting the host journal into a container is a much
//                     larger grant than a read-only directory.
//   OTLP logs       — the Ruby OTel Logs SDK is not the stable, instrumented
//                     path the traces SDK is; adopting it would replace a
//                     working logger contract with an experimental one.
//
// `/var/log/umaxica` is the repository `./log` directory, mounted read-only.
// The two sources stay separate because the two layers are separate: Lograge
// owns request-completion access logs, `Rails.logger` owns application and
// operational logs (docs/security/observability-boundary.md). They are not
// merged into one stream, and neither carries audit or security records —
// those remain database rows.
//
// `tail_from_end`: on a restart Alloy resumes from its stored position, and
// starts at the tail for a file it has never read. Without it a fresh volume
// replays whatever history the developer's log file happens to hold.
// Discovery is separate from tailing on purpose. A `loki.source.file` given a
// literal target logs "failed to create source, skipping" and never retries when
// the file does not yet exist — which is the normal state of a fresh clone, and
// of any machine where Rails has not been started since `podman compose up`
// (observed 2026-09-18). `local.file_match` re-checks on its sync period, so the
// tailer starts when Rails first writes the file.
local.file_match "rails_application" {
  path_targets = [
    {
      __path__     = "/var/log/umaxica/development.log",
      job          = "rails-application",
      service_name = "umaxica-apps-jit",
      layer        = "application",
    },
  ]

  sync_period = "15s"
}

local.file_match "rails_access" {
  path_targets = [
    {
      __path__     = "/var/log/umaxica/development.access.jsonl",
      job          = "rails-access",
      service_name = "umaxica-apps-jit",
      layer        = "access",
    },
  ]

  sync_period = "15s"
}

loki.source.file "rails_application" {
  targets       = local.file_match.rails_application.targets
  forward_to    = [loki.write.default.receiver]
  tail_from_end = true
}

loki.source.file "rails_access" {
  targets       = local.file_match.rails_access.targets
  forward_to    = [loki.process.access.receiver]
  tail_from_end = true
}

// Lograge emits one JSON object per line. Lifting the identifiers Grafana
// correlates on — and only those — keeps the label set bounded: a label per
// request path or per request_id would produce a new Loki stream per request.
// The line itself is forwarded unchanged, so nothing is added to it here.
loki.process "access" {
  stage.json {
    expressions = {
      method = "method",
      status = "status",
    }
  }

  stage.labels {
    values = {
      method = "",
      status = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

// ----------------------------------------------------------------------------
// Export: logs to Loki
// ----------------------------------------------------------------------------
// Retention is Loki's (podman/loki/loki.yaml, 24h). Rotation of the files on
// disk is Rails' (config/initializers/lograge.rb sizes and rotates the access
// log; `log/development.log` is the framework's own file). Neither side keeps
// development logs indefinitely.
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
