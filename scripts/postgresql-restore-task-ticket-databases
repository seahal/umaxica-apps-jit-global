#!/usr/bin/env ruby
# frozen_string_literal: true

# Rebuild only the three exact, manifest-owned task ticket databases from approved dumps.
require "pg"
require "json"
require "open3"

settings = File.readlines(".env.local", chomp: true).filter_map do |line|
  match = line.match(/\A([A-Z][A-Z0-9_]*)=(.*)\z/)
  match && [match[1], match[2].sub(/\A["']/, "").sub(/["']\z/, "")]
end.to_h
host = "primary"
port = Integer(settings.fetch("POSTGRESQL_PORT", "5432"), 10)
user = settings.fetch("POSTGRESQL_USER")
password = settings.fetch("POSTGRESQL_PASSWORD")
manifest_path = "tmp/postgresql-isolated-test-20260924.json"
manifest = JSON.parse(File.read(manifest_path))
comment = "Disposable isolated Codex PostgreSQL integrity verification 2026-09-24"
raise RuntimeError, "manifest target mismatch" unless manifest.values_at("run_id", "host", "port", "user") ==
  ["20260924", host, port, user]

admin = PG.connect(host:, port:, user:, password:, dbname: "postgres", connect_timeout: 3)
%w(app com org).each do |surface|
  name = "codex_integrity_20260924_#{surface}_ticket"
  entry = manifest.fetch("databases").find { |record| record.fetch("name") == name }
  raise RuntimeError, "ticket database absent from manifest" unless entry

  row = admin.exec_params(<<~SQL, [name]).first
    SELECT oid::text AS oid, pg_get_userbyid(datdba) AS owner,
           shobj_description(oid, 'pg_database') AS comment,
           (SELECT count(*) FROM pg_stat_activity WHERE datname = $1) AS connections
      FROM pg_database WHERE datname = $1
  SQL
  raise RuntimeError, "ticket database identity mismatch" unless row && row.fetch("oid") == entry.fetch("oid") &&
    row.fetch("owner") == user && row.fetch("comment") == comment && row.fetch("connections") == "0"

  admin.exec("DROP DATABASE #{PG::Connection.quote_ident(name)}")
  admin.exec("CREATE DATABASE #{PG::Connection.quote_ident(name)} TEMPLATE template0")
  admin.exec("COMMENT ON DATABASE #{PG::Connection.quote_ident(name)} IS '#{comment}'")
  env = { "PGHOST" => host,
          "PGPORT" => port.to_s,
          "PGUSER" => user,
          "PGPASSWORD" => password,
          "PGDATABASE" => name, }
  _output, error, status = Open3.capture3(
    env, "psql", "-X", "-v", "ON_ERROR_STOP=1", "-q",
    stdin_data: File.read("db/#{surface}_ticket_structure.sql"),
  )
  raise RuntimeError, "task dump load failed: #{surface}: #{error.lines.first}" unless status.success?

  entry["oid"] =
    admin.exec_params("SELECT oid::text AS oid FROM pg_database WHERE datname=$1", [name]).first.fetch("oid")
  puts "restored #{name} from checked-in dump"
end
File.write(manifest_path, JSON.pretty_generate(manifest))
admin.close
