#!/usr/bin/env ruby
# frozen_string_literal: true

require "date"
require "open3"
require "optparse"
require "uri"
require "yaml"

root = Pathname.new(__dir__).parent.realpath
abort("Run this checker from the repository root") unless Pathname.pwd.realpath == root
options = {}
OptionParser.new do |parser|
  parser.banner = "Usage: scripts/check-repository-knowledge [--base COMMIT] [paths...]"
  parser.on("--base COMMIT", "Also check changed specs and newly added evidence") { |value| options[:base] = value }
end.parse!

def git_output(*arguments)
  output, error, status = Open3.capture3("git", *arguments)
  abort("git #{arguments.first} failed: #{error.strip}") unless status.success?
  output
end

errors = []
check = ->(condition, message) { errors << message unless condition }
managed = %w(
  AGENTS.md CLAUDE.md README.md docs/index.md specs/README.md plans/README.md research/README.md
  manuals/README.md docs/reference/repository-knowledge-architecture.md
  docs/reference/agent-runtime-compatibility.md adr/repository-knowledge-and-agent-harness.md
)
managed.concat(Dir.glob("docs/checklists/*.md"))
managed.concat(Dir.glob("docs/risk-management/**/*.md"))
managed.concat(Dir.glob(".agents/harnesses/rules/**/*.mdc"))
skills = Dir.glob(".agents/skills/*/SKILL.md")
check.call(!skills.empty?, "No shared Skills found")
check.call(File.file?("CLAUDE.md") && File.read("CLAUDE.md").strip == "@AGENTS.md", "CLAUDE.md must import @AGENTS.md")

skills.each do |path|
  name = File.basename(File.dirname(path))
  body = File.read(path)
  match = body.match(/\A---\r?\n(.*?)\r?\n---(?:\r?\n|\z)/m)
  check.call(!match.nil?, "#{path}: missing YAML frontmatter")
  next unless match

  begin
    metadata = YAML.safe_load(match[1], permitted_classes: [], aliases: false)
  rescue Psych::Exception => e
    errors << "#{path}: invalid metadata (#{e.class})"
    next
  end
  unless metadata.is_a?(Hash)
    errors << "#{path}: metadata must be a mapping"
    next
  end
  check.call(name.match?(/\A[a-z0-9]+(?:-[a-z0-9]+)*\z/) && name.length <= 64, "#{path}: invalid folder name")
  check.call(metadata["name"] == name, "#{path}: name must match folder")
  description = metadata["description"]
  check.call(
    description.is_a?(String) && !description.strip.empty? && description.length <= 1024,
    "#{path}: description must contain 1..1024 characters",
  )
  adapter = ".claude/skills/#{name}"
  expected = "../../.agents/skills/#{name}"
  check.call(
    File.symlink?(adapter) && File.readlink(adapter) == expected && File.file?("#{adapter}/SKILL.md"),
    "#{adapter}: expected working symlink to #{expected}",
  )
  ignored, ignore_error, ignore_status = Open3.capture3("git", "check-ignore", "--no-index", adapter)
  abort("git check-ignore failed: #{ignore_error.strip}") unless [0, 1].include?(ignore_status.exitstatus)
  check.call(ignored.empty?, "#{adapter}: adapter is ignored by Git")
end

managed.concat(Dir.glob(".agents/skills/**/*.md"))
tracked_adapters = git_output("ls-files", "-z", "--", ".claude/skills").split("\0")
tracked_adapters.each do |path|
  next unless File.exist?(path) || File.symlink?(path)

  check.call(skills.include?(".agents/skills/#{File.basename(path)}/SKILL.md"), "#{path}: no canonical Skill")
end
Dir.glob(".agents/skills/*").each do |path|
  check.call(!File.symlink?(path) || File.file?("#{path}/SKILL.md"), "#{path}: broken canonical Skill link")
end

File.read("AGENTS.md").scan(/`((?:generic|project)\/[^`]+\.mdc|(?:docs|adr)\/[^`]+\.md)`/).flatten.each do |path|
  target = path.start_with?("generic/", "project/") ? ".agents/harnesses/rules/#{path}" : path
  check.call(File.file?(target), "AGENTS.md: missing routed file #{target}")
end

selected = ARGV.dup
new_evidence = []
if options[:base]
  base = git_output("rev-parse", "--verify", "#{options[:base]}^{commit}").strip
  selected.concat(
    git_output("diff", "--name-only", "--diff-filter=AM", "-z", base, "HEAD", "--", "specs")
      .split("\0").grep(/\.md\z/),
  )
  new_evidence.concat(
    git_output(
      "diff", "--name-only", "--diff-filter=A", "-z", base, "HEAD", "--",
      "evidence",
    ).split("\0"),
  )
end
selected.each do |path|
  check.call(
    !Pathname.new(path).absolute? && !Pathname.new(path).cleanpath.to_s.start_with?("../"),
    "Out-of-repository path: #{path}",
  )
end
abort(errors.join("\n")) unless errors.empty?
managed.concat(selected.reject { |path| path.start_with?("evidence/") })
new_evidence.concat(selected.grep(/\Aevidence\//))

managed.uniq!
managed.sort!
managed.each do |path|
  unless File.file?(path)
    errors << "Missing managed document: #{path}"
    next
  end
  content = File.read(path)
  # Historical citations and anchors need human review; this checks simple inline file destinations.
  prose = content.gsub(/^(`{3,}|~{3,}).*?^\1[^\n]*$/m, "")
  prose.scan(/\]\((?:<([^>]+)>|([^\s)]+))(?:\s+"[^"]*")?\)/).each do |angle, plain|
    href = angle || plain
    next if href.start_with?("#", "//") || href.match?(/\A[a-z][a-z0-9+.-]*:/i)

    target = URI::DEFAULT_PARSER.unescape(href.split(/[?#]/, 2).first)
    resolved = Pathname.new(File.dirname(path)).join(target).cleanpath
    check.call(resolved.exist?, "#{path}: unresolved file link #{href}")
  end
  next unless path.match?(%r{\Aspecs/[^/]+/spec\.md\z})

  status = content[/^Status:\s*(\S+)\s*$/, 1]
  check.call(
    %w(accepted implementing verified closed cancelled superseded).include?(status),
    "#{path}: invalid or missing Status",
  )
  ids = content.scan(/^\s*-\s+(AC-\d+):/).flatten
  check.call(!ids.empty? && ids.uniq.length == ids.length, "#{path}: acceptance IDs must exist and be unique")
end

new_evidence.uniq.each do |path|
  valid_name = path.match?(%r{\Aevidence/(\d{4}-\d{2}-\d{2})-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9A-Z]{4}\.md\z})
  check.call(valid_name, "#{path}: invalid evidence filename")
  if valid_name
    begin
      Date.iso8601(File.basename(path)[0, 10])
    rescue Date::Error
      errors << "#{path}: invalid evidence date"
    end
  end
  if File.file?(path)
    check.call(File.read(path).match?(/\b[0-9a-f]{40}\b/), "#{path}: full commit hash required")
  else
    errors << "#{path}: evidence file missing"
  end
end

abort(errors.join("\n")) unless errors.empty?
puts "Knowledge structure passed: #{skills.length} Skills/adapters, " \
     "#{managed.length} documents, #{new_evidence.uniq.length} evidence records."
