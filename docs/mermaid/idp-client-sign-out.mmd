stateDiagram-v2
    %% Terminal absorption precedes TTL and requested source validation.
    %% Where the lifecycle has expires_at, overdue requests persist EXPIRED first.
    %% The owning transaction returns an expiry refusal; callers unwrap only after commit.
    %% A refused locked operation rolls back its savepoint before persisting expiry.
    %% CURRENT implementation; sources and guards in transition inventory.
    state "NOTHING id=0" as NOTHING
    state "REQUESTED id=10" as REQUESTED
    state "ACCESS_DISCARDED id=20" as ACCESS_DISCARDED
    state "LOGICALLY_REVOKED id=30" as LOGICALLY_REVOKED
    state "COMPLETED id=100" as COMPLETED
    state "FAILED id=900 (tombstone)" as FAILED
    state "EXPIRED id=910" as EXPIRED
    state "CANCELLED id=920" as CANCELLED
    state "HALTED id=930" as HALTED
    [*] --> REQUESTED
    NOTHING --> REQUESTED: request_sign_out!
    REQUESTED --> ACCESS_DISCARDED: mark_access_discarded!
    ACCESS_DISCARDED --> LOGICALLY_REVOKED: mark_logically_revoked!
    LOGICALLY_REVOKED --> COMPLETED: complete_sign_out!
    REQUESTED --> EXPIRED: expire_sign_out!
    REQUESTED --> CANCELLED: cancel_sign_out!
    REQUESTED --> HALTED: halt_sign_out!
    ACCESS_DISCARDED --> EXPIRED: expire_sign_out!
    ACCESS_DISCARDED --> CANCELLED: cancel_sign_out!
    ACCESS_DISCARDED --> HALTED: halt_sign_out!
    LOGICALLY_REVOKED --> EXPIRED: expire_sign_out!
    LOGICALLY_REVOKED --> CANCELLED: cancel_sign_out!
    LOGICALLY_REVOKED --> HALTED: halt_sign_out!
    COMPLETED --> [*]
    FAILED --> [*]
    EXPIRED --> [*]
    CANCELLED --> [*]
    HALTED --> [*]
    note right of NOTHING
        Database default REQUESTED id=10.
        NOTHING id=0 is an optional model predecessor.
        Authority-first logout completes after LOGICALLY_REVOKED.
    end note
    note right of REQUESTED
        Browser/RP logout transport uses the Base authority boundary.
        AWAITING_EXPIRY and FAILED are retained reference tombstones;
        no new writer enters them.
    end note
