stateDiagram-v2
    %% CURRENT implementation; sources and guards in transition inventory.
    state "pending" as pending
    state "approved" as approved
    state "rejected" as rejected
    state "executed" as executed
    state "cancelled" as cancelled
    [*] --> pending
    pending --> approved: approve
    pending --> rejected: reject
    approved --> executed: execute
    note right of approved
        Deactivation checks for another capability-eligible
        operator, including status and withdrawal state;
        OP stop delivery follows actor transaction commit.
    end note
    rejected --> [*]
    executed --> [*]
    cancelled --> [*]
