stateDiagram-v2
    %% CURRENT implementation; sources and guards in transition inventory.
    state "ACTIVE id=1" as ACTIVE
    state "EXPIRED id=2" as EXPIRED
    state "REVOKED id=3" as REVOKED
    state "USED id=4" as USED
    state "DELETED id=5" as DELETED
    state "NOTHING id=6" as NOTHING
    ACTIVE --> REVOKED: SignSecretVerify mismatch at failure cap
    ACTIVE --> ACTIVE: SignSecretVerify accepted reusable secret
    [*] --> ACTIVE
    ACTIVE --> EXPIRED: expire_if_needed!
    ACTIVE --> USED: SignSecretVerify accepted single-use
    ACTIVE --> REVOKED: withdrawal anonymize
    EXPIRED --> REVOKED: withdrawal anonymize
    REVOKED --> REVOKED: withdrawal anonymize
    USED --> REVOKED: withdrawal anonymize
    DELETED --> REVOKED: withdrawal anonymize
    NOTHING --> REVOKED: withdrawal anonymize
