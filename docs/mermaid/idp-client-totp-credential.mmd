stateDiagram-v2
    %% CURRENT implementation; sources and guards in transition inventory.
    state "ACTIVE id=1" as ACTIVE
    state "INACTIVE id=2" as INACTIVE
    state "REVOKED id=3" as REVOKED
    state "DELETED id=4" as DELETED
    state "NOTHING id=5" as NOTHING
    ACTIVE --> REVOKED: withdrawal anonymizer direct write
    INACTIVE --> REVOKED: withdrawal anonymizer direct write
    NOTHING --> REVOKED: withdrawal anonymizer direct write
    DELETED --> REVOKED: withdrawal anonymizer direct write
    REVOKED --> REVOKED: withdrawal anonymizer direct write
    [*] --> NOTHING
    [*] --> ACTIVE
    ACTIVE --> ACTIVE: record_totp_failure! below100
    ACTIVE --> REVOKED: record_totp_failure! at100
    ACTIVE --> ACTIVE: record_totp_success!
    ACTIVE --> DELETED: credential removal
    INACTIVE --> DELETED: credential removal
    NOTHING --> DELETED: credential removal
    REVOKED --> [*]
    DELETED --> [*]
