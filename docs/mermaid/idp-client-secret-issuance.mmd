stateDiagram-v2
    %% CURRENT implementation; sources and guards in transition inventory.
    state "pending_presentation (derived)" as pending_presentation
    state "pending_confirmation (derived)" as pending_confirmation
    state "confirmed (derived)" as confirmed
    state "canceled (derived)" as canceled
    state "expired (derived)" as expired
    state "omitted (derived)" as omitted
    [*] --> pending_presentation
    [*] --> omitted
    pending_presentation --> pending_confirmation: explicit protected POST presents fixed set
    pending_confirmation --> confirmed: storage confirmation
    pending_presentation --> canceled: manual cancel
    pending_confirmation --> canceled: manual cancel
    pending_presentation --> expired: clock reaches expires_at
    pending_confirmation --> expired: clock reaches expires_at
    state "signup authentication gated (signup_completed_at absent)" as signup_gated
    state "signup authentication activated (signup_completed_at recorded)" as signup_activated
    confirmed --> signup_gated: signup-bound batch only
    signup_gated --> signup_activated: durable signup completed; source Client registered and login allowed; audited completion fact commit
    state "signup batch retired (discard_at recorded; activation absent)" as signup_retired
    signup_gated --> signup_retired: locked signup CANCELLED / EXPIRED / FAILED
    signup_retired --> [*]: terminal audit gates physical collection
    signup_activated --> [*]
    confirmed --> [*]: signed-in batch
    canceled --> [*]
    state "expired allocation physically collected" as expired_purged
    expired --> expired_purged: retirement deadline; no candidates; terminal Chronicle commit; no hold; DELETE and surviving issuance_purged outbox in Source transaction
    expired_purged --> [*]
    omitted --> [*]

%% Withdrawal cancellation shares the existing canceled axis, requires terminated Client proof,
%% erases encrypted payload and releases reservation under the source Client lock.
