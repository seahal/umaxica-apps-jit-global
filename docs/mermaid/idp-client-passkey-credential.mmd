stateDiagram-v2
    %% CURRENT implementation; sources and guards in transition inventory.
    %% Removal commits Ticket invalidation before deletion and the source audit when no outer Ticket transaction exists.
    state "ACTIVE id=1" as ACTIVE
    state "DISABLED id=2" as DISABLED
    state "REVOKED id=3" as REVOKED
    state "DELETED id=4" as DELETED
    state "NOTHING id=5" as NOTHING
    state "physically removed" as REMOVED
    ACTIVE --> REVOKED: withdrawal anonymizer direct write
    DISABLED --> REVOKED: withdrawal anonymizer direct write
    REVOKED --> REVOKED: withdrawal anonymizer direct write
    DELETED --> REVOKED: withdrawal anonymizer direct write
    NOTHING --> REVOKED: withdrawal anonymizer direct write
    [*] --> ACTIVE
    ACTIVE --> REMOVED: owner and target-bound Step-Up; removal audit
    DISABLED --> REMOVED: owner and target-bound Step-Up; removal audit
    NOTHING --> REMOVED: owner and target-bound Step-Up; removal audit
    REVOKED --> [*]
    ACTIVE --> DELETED: SignUpArtifactCleanup dependent retention
    DISABLED --> DELETED: SignUpArtifactCleanup dependent retention
    REVOKED --> DELETED: SignUpArtifactCleanup dependent retention
    DELETED --> DELETED: SignUpArtifactCleanup dependent retention
    NOTHING --> DELETED: SignUpArtifactCleanup dependent retention
