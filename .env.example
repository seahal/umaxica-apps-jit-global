# Umaxica Global local development contract (non-secret defaults).
# Rails reads this automatically when .env is absent. Override locally in .env;
# never put production credentials or tokens in this file.
# Host-native Rails uses loopback. Dev Containers bootstrap .env from
# .env.devcontainer.example so application settings stay independent of Compose.
NODE_ENV=development
RAILS_MAX_THREADS=3
PORT=3000
BINDING=127.0.0.1
BRAND_NAME=UMAXICA
TMPDIR=/tmp/umaxica-vitest
BUNDLE_PATH=vendor/bundle
VITE_RUBY_HOST=127.0.0.1
VITE_RUBY_PORT=3036
VITE_RUBY_PACKAGE_MANAGER=bun
VITE_GIT_HOOKS=0
POSTGRESQL_HOST=127.0.0.1
POSTGRESQL_PORT=5432
POSTGRESQL_USER=root
POSTGRESQL_PASSWORD=development
POSTGRESQL_DATABASE=db
POSTGRESQL_TEST_HOST=127.0.0.1
POSTGRESQL_APP_ZENITH_PUB=127.0.0.1
POSTGRESQL_APP_ZENITH_SUB=127.0.0.1
POSTGRESQL_ORG_ZENITH_PUB=127.0.0.1
POSTGRESQL_ORG_ZENITH_SUB=127.0.0.1
POSTGRESQL_COM_ZENITH_PUB=127.0.0.1
POSTGRESQL_COM_ZENITH_SUB=127.0.0.1
POSTGRESQL_APP_SETTING_PUB=127.0.0.1
POSTGRESQL_APP_SETTING_SUB=127.0.0.1
POSTGRESQL_ORG_SETTING_PUB=127.0.0.1
POSTGRESQL_ORG_SETTING_SUB=127.0.0.1
POSTGRESQL_COM_SETTING_PUB=127.0.0.1
POSTGRESQL_COM_SETTING_SUB=127.0.0.1
POSTGRESQL_APP_TICKET_PUB=127.0.0.1
POSTGRESQL_APP_TICKET_SUB=127.0.0.1
POSTGRESQL_ORG_TICKET_PUB=127.0.0.1
POSTGRESQL_ORG_TICKET_SUB=127.0.0.1
POSTGRESQL_COM_TICKET_PUB=127.0.0.1
POSTGRESQL_COM_TICKET_SUB=127.0.0.1
POSTGRESQL_APP_SIGNAL_PUB=127.0.0.1
POSTGRESQL_APP_SIGNAL_SUB=127.0.0.1
POSTGRESQL_ORG_SIGNAL_PUB=127.0.0.1
POSTGRESQL_ORG_SIGNAL_SUB=127.0.0.1
POSTGRESQL_COM_SIGNAL_PUB=127.0.0.1
POSTGRESQL_COM_SIGNAL_SUB=127.0.0.1
